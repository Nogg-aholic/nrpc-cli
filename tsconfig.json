{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0",
    "types": ["node", "bun"],
    "baseUrl": ".",
    "paths": {
      "@nogg-aholic/nrpc": [
        "../nRPC/dist/index.d.ts",
        "../nRPC/src/index.ts"
      ],
      "@nogg-aholic/nrpc/*": [
        "../nRPC/dist/*.d.ts",
        "../nRPC/src/*.ts"
      ]
    },
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts"
  ]
}